---
import { ChevronLeftIcon, ChevronRightIcon, GithubIcon } from "./lucide-icons.tsx";
import {
  CREDIT_HANDLE,
  CREDIT_URL,
  GITHUB_HANDLE,
  GITHUB_URL,
} from "../lib/follow-prompt";

/**
 * "Follow me on GitHub" prompt — a two-slide carousel.
 *
 * Slide 1 asks for the follow; slide 2 is the credit roll. It stays up until the
 * visitor acts: the close button, "Maybe later"/"Close", the backdrop, Escape,
 * or the CTA. Dismissing is a deferral — the prompt returns on the next visit
 * until the GitHub link is actually clicked (see `lib/follow-prompt.ts`).
 *
 * Both image srcs are injected by the script only when the prompt is eligible
 * to show, so visitors who have already followed never pay for the download.
 */

const abs = (p: string) => `${import.meta.env.BASE_URL.replace(/\/?$/, "/")}${p}`;
const CAT_GIF = abs("images/cat-please.gif");
const CREDIT_IMG = abs("images/digal.jpg");
---

<div class="follow-scrim" id="followScrim" data-gif={CAT_GIF} data-credit={CREDIT_IMG} hidden>
  <div
    class="follow-modal"
    role="dialog"
    aria-modal="true"
    aria-roledescription="carousel"
    aria-label="Did this help you pass?"
  >
    <div class="follow-stage" id="followStage">
      <div class="follow-track" id="followTrack">
        <section class="follow-slide" data-slide="0">
          <div class="follow-media">
            <img
              id="followGif"
              alt="A cat standing on its hind legs, asking for something please"
              width="400"
              height="303"
              decoding="async"
            />
          </div>
          <div class="follow-body">
            <h2 class="follow-title">Did this help you pass?</h2>
            <p class="follow-desc">
              These CCNA 2 v7 practice exams are free and open source. If this helped you
              pass the exam, a follow would be greatly appreciated.
            </p>
            <div class="follow-actions">
              <a
                class="follow-cta"
                id="followCta"
                href={GITHUB_URL}
                target="_blank"
                rel="noopener noreferrer"
              >
                <GithubIcon size={18} />
                <span>Follow @{GITHUB_HANDLE}</span>
              </a>
              <button type="button" class="link-btn follow-later" id="followLater">
                Maybe later
              </button>
            </div>
          </div>
        </section>

        <section class="follow-slide" data-slide="1" inert>
          <div class="follow-media">
            <img
              id="followCreditImg"
              alt="Digal, the contributor behind the questions in these practice exams"
              width="600"
              height="800"
              decoding="async"
            />
          </div>
          <div class="follow-body">
            <h2 class="follow-title">Special thanks to DigalTzy</h2>
            <p class="follow-desc">
              This project would not have been possible without his contribution — the
              questions, explanations and exhibit images across every exam group are his
              work.
            </p>
            <div class="follow-actions">
              <a
                class="follow-cta"
                id="followCreditCta"
                href={CREDIT_URL}
                target="_blank"
                rel="noopener noreferrer"
              >
                <GithubIcon size={18} />
                <span>@{CREDIT_HANDLE}</span>
              </a>
              <button type="button" class="link-btn follow-later" id="followCreditClose">
                Close
              </button>
            </div>
          </div>
        </section>
      </div>

      {/**
        Controls ride on the photo rather than in a row of their own — a
        separate strip below the copy left a band of blank space under the
        buttons and made the modal taller than it needed to be.
      */}
      <div class="follow-nav">
        <div class="follow-dots" id="followDots">
          <button
            type="button"
            class="follow-dot is-current"
            data-goto="0"
            aria-label="Show the follow request"
            aria-current="true"
          ></button>
          <button
            type="button"
            class="follow-dot"
            data-goto="1"
            aria-label="Show the special thanks"
          ></button>
        </div>
        <button
          type="button"
          class="follow-next"
          id="followNext"
          aria-label="Show the special thanks"
        >
          <ChevronRightIcon className="follow-next-fwd" size={20} strokeWidth={2.4} />
          <ChevronLeftIcon className="follow-next-back" size={20} strokeWidth={2.4} />
        </button>
      </div>
    </div>

    <button type="button" class="follow-close" id="followClose" aria-label="Dismiss for now">
      <svg class="follow-x" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </div>
</div>

<script>
  import { GITHUB_URL, hasFollowed, markFollowed } from "../lib/follow-prompt";

  /**
   * Two ways in, matching the app's existing CustomEvent convention:
   *  - any element carrying `data-follow-open` (the credit). Always opens: the
   *    visitor asked for it by clicking, so following is no longer required.
   *  - `follow:open` on document, dispatched by the exam page when the score
   *    lands. This one is an *ask*, not a request, so it goes quiet for good
   *    once the visitor has followed.
   */
  const OPEN_EVENT = "follow:open";

  const scrim = document.getElementById("followScrim");
  if (scrim && !scrim.dataset.ready) {
    scrim.dataset.ready = "1";
    start(scrim);
  }

  function start(root: HTMLElement): void {
    const modal = root.querySelector<HTMLElement>(".follow-modal")!;
    const stage = root.querySelector<HTMLElement>("#followStage")!;
    const track = root.querySelector<HTMLElement>("#followTrack")!;
    const gif = root.querySelector<HTMLImageElement>("#followGif")!;
    const creditImg = root.querySelector<HTMLImageElement>("#followCreditImg")!;
    const cta = root.querySelector<HTMLAnchorElement>("#followCta")!;
    const creditCta = root.querySelector<HTMLAnchorElement>("#followCreditCta")!;
    const nextBtn = root.querySelector<HTMLButtonElement>("#followNext")!;
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>(".follow-dot"));
    const slides = Array.from(root.querySelectorAll<HTMLElement>(".follow-slide"));

    /** Horizontal travel of a swipe that counts as a deliberate flick (px). */
    const SWIPE_MIN = 45;

    let index = 0;
    let closing = false;
    let lastFocused: HTMLElement | null = null;
    let touchX = 0;
    let touchY = 0;
    let tracking = false;

    // The off-screen slide is inert, so it leaves the tab order and the focus
    // trap without duplicating the copy for screen readers.
    const focusables = (): HTMLElement[] =>
      Array.from(modal.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')).filter(
        (el) => el.closest("[inert]") === null,
      );

    function go(next: number): void {
      const clamped = Math.max(0, Math.min(slides.length - 1, next));
      if (clamped === index) return;
      index = clamped;
      render();
    }

    function render(): void {
      track.style.transform = `translateX(-${index * 50}%)`;
      slides.forEach((slide, i) => {
        if (i === index) slide.removeAttribute("inert");
        else slide.setAttribute("inert", "");
      });
      dots.forEach((dot, i) => {
        dot.classList.toggle("is-current", i === index);
        if (i === index) dot.setAttribute("aria-current", "true");
        else dot.removeAttribute("aria-current");
      });
      // One control, two meanings: forward on the first slide, back on the last.
      const back = index > 0;
      nextBtn.classList.toggle("is-back", back);
      nextBtn.setAttribute(
        "aria-label",
        back ? "Back to the follow request" : "Show the special thanks",
      );
      nextBtn.title = back ? "Back" : "Special thanks";
    }

    function open(): void {
      // Already up — don't yank it out from under whoever is reading it.
      if (!root.hidden) return;
      closing = false;
      lastFocused = document.activeElement as HTMLElement | null;
      // Deferred so visitors who already followed never download the images.
      gif.src = root.dataset.gif ?? "";
      creditImg.src = root.dataset.credit ?? "";
      root.hidden = false;
      document.body.style.overflow = "hidden";
      // Capture phase so this wins over the exam page's global Escape handler.
      window.addEventListener("keydown", onKey, true);
      requestAnimationFrame(() => {
        root.classList.add("is-open");
        cta.focus({ preventScroll: true });
      });
    }

    function close(pressedCta: boolean): void {
      if (closing) return;
      closing = true;
      // Only a real click on the owner's CTA retires the prompt for good;
      // the credit link and every dismiss path are deferrals.
      if (pressedCta) markFollowed();
      root.classList.remove("is-open");
      document.body.style.overflow = "";
      window.removeEventListener("keydown", onKey, true);
      window.setTimeout(() => {
        root.hidden = true;
        gif.removeAttribute("src");
        creditImg.removeAttribute("src");
        lastFocused?.focus?.({ preventScroll: true });
      }, 260);
    }

    function onKey(e: KeyboardEvent): void {
      if (e.key === "Escape") {
        e.preventDefault();
        e.stopPropagation();
        close(false);
        return;
      }
      // Arrow keys page the carousel while it owns the keyboard.
      if (e.key === "ArrowRight") {
        e.preventDefault();
        go(index + 1);
        return;
      }
      if (e.key === "ArrowLeft") {
        e.preventDefault();
        go(index - 1);
        return;
      }
      if (e.key !== "Tab") return;
      // Keep Tab inside the dialog — it is modal, so the page behind is inert.
      const items = focusables();
      if (items.length === 0) return;
      const first = items[0];
      const last = items[items.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }

    /* ------------------------------- navigation ------------------------------- */

    nextBtn.addEventListener("click", () => go(index + (index > 0 ? -1 : 1)));
    dots.forEach((dot) =>
      dot.addEventListener("click", () => go(Number(dot.dataset.goto ?? 0))),
    );

    // Swipe right-to-left for the next slide, left-to-right to go back. Tracked
    // on the media stage so a drag never fights the scrollable page behind.
    stage.addEventListener(
      "touchstart",
      (e) => {
        const t = e.touches[0];
        if (!t) return;
        touchX = t.clientX;
        touchY = t.clientY;
        tracking = true;
      },
      { passive: true },
    );
    stage.addEventListener(
      "touchend",
      (e) => {
        if (!tracking) return;
        tracking = false;
        const t = e.changedTouches[0];
        if (!t) return;
        const dx = t.clientX - touchX;
        const dy = t.clientY - touchY;
        // Horizontal intent only — a vertical flick is a scroll, not a page turn.
        if (Math.abs(dx) < SWIPE_MIN || Math.abs(dx) <= Math.abs(dy)) return;
        go(index + (dx < 0 ? 1 : -1));
      },
      { passive: true },
    );

    root.addEventListener("click", (e) => {
      // Backdrop click defers.
      if (e.target === root) close(false);
    });
    root.querySelector("#followClose")!.addEventListener("click", () => close(false));
    root.querySelector("#followLater")!.addEventListener("click", () => close(false));
    root.querySelector("#followCreditClose")!.addEventListener("click", () => close(false));
    // The one interaction that retires the prompt for good.
    cta.addEventListener("click", () => close(cta.href.startsWith(GITHUB_URL)));
    creditCta.addEventListener("click", () => close(false));

    document
      .querySelectorAll<HTMLElement>("[data-follow-open]")
      .forEach((el) => el.addEventListener("click", open));
    document.addEventListener(OPEN_EVENT, () => {
      if (!hasFollowed()) open();
    });

    // First load of a session asks once; after that only the result screen
    // and the credit bring it back.
    if (!hasFollowed()) open();
  }
</script>
