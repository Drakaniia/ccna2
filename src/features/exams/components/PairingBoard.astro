---
---
<!-- Mount point is #qBody (inside QuestionView). Click-to-pair matching board
     is rendered client-side per click-to-pair.md and reacts to shared state. -->

<style is:global>
  /* ================================
     CLICK TO PAIR / MATCHING QUESTION
  ================================ */
  .pairing-board {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 70px;
    position: relative;
    min-height: 270px;
  }

  .pair-column {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .pair-item {
    min-height: 56px;
    padding: 0 14px 0 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #fafafa;
    border: 2px solid #d6dce1;
    border-radius: 7px;
    cursor: pointer;
    transition: 0.2s ease;
    font-size: 14px;
  }

  /* hover feedback only applies while the item can still be changed */
  .pair-item:not(.locked):hover {
    border-color: #9fb5bf;
  }

  .pair-item.locked {
    cursor: default;
  }

  .pair-item.active {
    border-color: #12a0c6;
    background: #d9eef4;
  }

  /* matched items are tinted with their own pair color */
  .pair-item.matched {
    border-color: var(--pb, #8fc783);
    background: var(--pt, #eef7ea);
  }

  /* selecting a (matched) left item highlights it in cyan */
  .pair-item.matched.active {
    border-color: #12a0c6;
    background: #d9eef4;
  }

  /* check feedback */
  .pair-item.wrong {
    border-color: var(--red);
    background: #fdeeee;
  }

  .pair-item.reveal-correct {
    border-color: var(--green);
    background: #eef7e9;
  }

  /* the badge always sits on the INNER edge of its card (right edge for the
     left column, left edge for the right column) and overlaps the border, so
     the two badge circles face each other across the gap. */
  .pair-right {
    gap: 14px;
  }

  .pair-right .pair-badge {
    margin-left: -27px;
  }

  .pair-item:not(.pair-right) .pair-badge {
    margin-right: -27px;
  }

  .pair-badge {
    box-sizing: border-box;
    min-width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 2px solid #cfe3d8;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #d9f0e4;
    color: #397448;
    font-size: 13px;
    font-weight: 700;
    /* above the connector lines so the line tucks under the circle */
    position: relative;
    z-index: 6;
    flex-shrink: 0;
    padding: 0;
    white-space: nowrap;
  }

  /* two left items can share one right target -> widen into a pill */
  .pair-badge.multi {
    border-radius: 15px;
    padding: 0 9px;
  }

  .pair-right .pair-badge {
    background: #e5f4f6;
    color: #337783;
    border-color: #c3dfe4;
  }

  /* an unmatched badge reserves its slot but stays invisible (declared last so
     it also wins over the right-column default above) */
  .pair-badge.empty,
  .pair-right .pair-badge.empty {
    background: transparent;
    border-color: transparent;
  }

  /* distinct light colors per pair letter (shared by left + matched right badge) */
  .pair-badge.letter-0 { background: #ffe0bf; color: #8a4a0f; border-color: #e9a35c; }
  .pair-badge.letter-1 { background: #d3e6ff; color: #123f6e; border-color: #6fa3e8; }
  .pair-badge.letter-2 { background: #d6f0d3; color: #1e5b1e; border-color: #7cc173; }
  .pair-badge.letter-3 { background: #fbd8ec; color: #8c2c61; border-color: #e58cbe; }
  .pair-badge.letter-4 { background: #e2d9fb; color: #452a92; border-color: #a48fe6; }
  .pair-badge.letter-5 { background: #fbdada; color: #8f2020; border-color: #e08a8a; }
  .pair-badge.letter-6 { background: #fdf0c2; color: #7a5d08; border-color: #d8bd52; }

  .pair-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 5;
  }

  .pair-status {
    margin-top: 14px;
    color: #666;
    font-size: 13px;
  }

  .pair-answer-title {
    margin-top: 22px;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: var(--green-dark);
  }

  .pair-answer-table {
    width: 100%;
    margin-top: 8px;
    border-collapse: collapse;
    background: #fff;
    font-size: 14px;
  }

  .pair-answer-table th,
  .pair-answer-table td {
    border: 1px solid var(--border);
    padding: 10px 14px;
    text-align: left;
    vertical-align: top;
  }

  .pair-answer-table thead th {
    background: #eef4f6;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--muted);
  }

  .pair-answer-table td.pair-arrow {
    width: 40px;
    text-align: center;
    color: var(--green);
    font-size: 16px;
    padding-left: 4px;
    padding-right: 4px;
  }

  .pair-answer-table td:last-child {
    font-weight: 600;
    color: var(--green-dark);
  }

  @media (max-width: 800px) {
    .pairing-board {
      gap: 62px;
    }
  }
</style>

<script>
  import { clickLeftItem, clickRightItem, getActiveLeft, getModule, getState, subscribe } from "../lib/quiz-state";

  const LETTERS = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";

  // per-letter colors for the matched border + background tint
  const PAIR_COLORS = [
    { border: "#e68a2e", tint: "#fff3e4" },
    { border: "#4a90d9", tint: "#eaf3ff" },
    { border: "#5aa84f", tint: "#edf8ec" },
    { border: "#d76ba0", tint: "#fdf0f7" },
    { border: "#7d5fd1", tint: "#f4f0fd" },
    { border: "#d15757", tint: "#fdf0f0" },
    { border: "#cfa92e", tint: "#fdf9e8" },
  ];

  // darker letters for html[data-theme="dark"] (translucent tints keep text readable)
  const PAIR_COLORS_DARK = [
    { border: "#f0a35c", tint: "rgba(230, 138, 46, 0.20)" },
    { border: "#7ab0ef", tint: "rgba(74, 144, 217, 0.20)" },
    { border: "#8fd184", tint: "rgba(90, 168, 79, 0.20)" },
    { border: "#ef9ac5", tint: "rgba(215, 107, 160, 0.20)" },
    { border: "#aa94ec", tint: "rgba(125, 95, 209, 0.20)" },
    { border: "#f08a8a", tint: "rgba(209, 87, 87, 0.20)" },
    { border: "#e8c95e", tint: "rgba(207, 169, 46, 0.20)" },
  ];

  function pairColors(): typeof PAIR_COLORS {
    return document.documentElement.dataset.theme === "dark"
      ? PAIR_COLORS_DARK
      : PAIR_COLORS;
  }

  function pairBoardArea(): HTMLElement | null {
    return document.getElementById("qBody");
  }

  function renderBoard(): void {
    const st = getState();
    const mod = getModule();
    const host = pairBoardArea();
    if (!st || !mod || !host) return;

    const p = st.current;
    const q = mod.questions[st.order[p]];
    if (!q || q.type !== "pair") return;

    const rightOrder = st.rightOrders[p] ?? [];
    // Left column is shuffled per attempt as well: display position -> source left.
    const leftOrder = st.leftOrders[p] ?? q.left.map((_, i) => i);
    // source left index -> its display position (drives the letter badges)
    const leftPos = new Map<number, number>();
    leftOrder.forEach((srcLeft, pos) => leftPos.set(srcLeft, pos));
    const pairs = st.pairs[p] ?? {};
    const checked = !!st.checked[p];
    const active = getActiveLeft();

    // what display position holds the correct source-right for each left item
    const expected = new Map<number, number>();
    q.left.forEach((_, L) => {
      expected.set(L, rightOrder.indexOf(q.correctPairs[L]));
    });

    const wrap = document.createElement("div");

    const board = document.createElement("div");
    board.className = "pairing-board";

    const svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
    svg.classList.add("pair-lines");

    const leftColumn = document.createElement("div");
    leftColumn.className = "pair-column";
    const rightColumn = document.createElement("div");
    rightColumn.className = "pair-column";

    // LEFT items (shuffled display order; letter badges A, B, C, ... follow the
    // position on screen so they still read top-to-bottom)
    leftOrder.forEach((srcLeft, pos) => {
      const item = document.createElement("div");
      item.className = "pair-item";
      item.dataset.left = String(srcLeft);

      const userRight = pairs[srcLeft];
      if (active === srcLeft) item.classList.add("active");
      if (checked) item.classList.add("locked");
      if (userRight !== undefined) {
        item.classList.add("matched");
        applyPairColor(item, pos);
        if (checked) {
          item.classList.add(userRight === expected.get(srcLeft) ? "reveal-correct" : "wrong");
        }
      }

      const label = document.createElement("span");
      label.textContent = q.left[srcLeft];
      const badge = document.createElement("span");
      badge.className = `pair-badge letter-${pos % PAIR_COLORS.length}`;
      badge.textContent = LETTERS[pos] ?? String(pos + 1);

      item.append(label, badge);
      item.addEventListener("click", () => clickLeftItem(srcLeft));
      leftColumn.appendChild(item);
    });

    // RIGHT items (shuffled display order; badge shows the paired left letter)
    rightOrder.forEach((sourceIdx, R) => {
      const item = document.createElement("div");
      item.className = "pair-item pair-right";
      item.dataset.right = String(R);

      const pairedLefts = Object.keys(pairs)
        .filter((l) => pairs[Number(l)] === R)
        .map(Number)
        // partners listed in on-screen order so the badge reads A,B (not B,A)
        .sort((a, b) => (leftPos.get(a) ?? a) - (leftPos.get(b) ?? b));
      // letter of each partner's position in the shuffled left column
      const badgeText = pairedLefts
        .map((l) => LETTERS[leftPos.get(l) ?? l] ?? String(l + 1))
        .join(",");
      if (checked) item.classList.add("locked");

      const badge = document.createElement("span");
      badge.className = "pair-badge";
      if (pairedLefts.length > 0) {
        // matched right badges echo their left partner(s)' light color
        badge.classList.add(`letter-${(leftPos.get(pairedLefts[0]!) ?? pairedLefts[0]!) % PAIR_COLORS.length}`);
        badge.classList.add("multi");
      } else {
        // no partner yet: keep the slot sized but show nothing
        badge.classList.add("empty");
      }
      badge.textContent = badgeText;
      const label = document.createElement("span");
      label.textContent = q.right[sourceIdx];

      if (pairedLefts.length > 0) {
        item.classList.add("matched");
        applyPairColor(item, leftPos.get(pairedLefts[0]!) ?? pairedLefts[0]!);
      }

      item.append(badge, label);
      item.addEventListener("click", () => clickRightItem(R));
      rightColumn.appendChild(item);
    });

    board.append(leftColumn, rightColumn, svg);
    wrap.appendChild(board);

    const status = document.createElement("div");
    status.className = "pair-status";
    status.textContent = `${Object.keys(pairs).length} of ${q.left.length} pairs matched`;
    wrap.appendChild(status);

    // Check mode: aligned table of the correct matches under the board
    if (checked) {
      const title = document.createElement("div");
      title.className = "pair-answer-title";
      title.textContent = "Correct matches";
      wrap.appendChild(title);

      const table = document.createElement("table");
      table.className = "pair-answer-table";

      const head = document.createElement("thead");
      const headRow = document.createElement("tr");
      const thItem = document.createElement("th");
      thItem.textContent = "Item";
      const thArrow = document.createElement("th");
      thArrow.className = "pair-arrow";
      thArrow.textContent = "";
      const thMatch = document.createElement("th");
      thMatch.textContent = "Correct match";
      headRow.append(thItem, thArrow, thMatch);
      head.appendChild(headRow);
      table.appendChild(head);

      const body = document.createElement("tbody");
      q.left.forEach((leftText, L) => {
        const row = document.createElement("tr");
        const cellItem = document.createElement("td");
        cellItem.textContent = leftText;
        const cellArrow = document.createElement("td");
        cellArrow.className = "pair-arrow";
        cellArrow.textContent = "→";
        const rightSrc = q.correctPairs[L];
        const cellMatch = document.createElement("td");
        cellMatch.textContent = q.right[rightSrc];
        row.append(cellItem, cellArrow, cellMatch);
        body.appendChild(row);
      });
      table.appendChild(body);
      wrap.appendChild(table);
    }

    host.replaceChildren(wrap);

    requestAnimationFrame(() => drawLines(wrap, svg, pairs, checked, expected));
  }

  /** Tint a matched item with its own pair color (border + background). */
  function applyPairColor(item: HTMLElement, leftIndex: number): void {
    const colors = pairColors();
    const c = colors[leftIndex % colors.length];
    item.style.setProperty("--pb", c.border);
    item.style.setProperty("--pt", c.tint);
  }

  function drawLines(
    wrap: HTMLElement,
    svg: SVGSVGElement,
    pairs: Record<number, number>,
    checked: boolean,
    expected: Map<number, number>
  ): void {
    const board = wrap.querySelector(".pairing-board");
    if (!board) return;

    const boardRect = board.getBoundingClientRect();
    svg.setAttribute("viewBox", `0 0 ${boardRect.width} ${boardRect.height}`);
    svg.replaceChildren();


    const addLine = (
      x1: number, y1: number, x2: number, y2: number,
      stroke: string, dashed = false
    ): void => {
      const line = document.createElementNS("http://www.w3.org/2000/svg", "line");
      line.setAttribute("x1", String(x1));
      line.setAttribute("y1", String(y1));
      line.setAttribute("x2", String(x2));
      line.setAttribute("y2", String(y2));
      line.setAttribute("stroke", stroke);
      line.setAttribute("stroke-width", "2");
      if (dashed) line.setAttribute("stroke-dasharray", "6 4");
      svg.appendChild(line);
    };

    // Anchors sit on the letter badge, not the card: the line leaves the left
    // badge on its right edge and lands on the right badge's left edge.
    const badgeAnchor = (
      item: Element | null,
      side: "left" | "right"
    ): { x: number; y: number } | null => {
      if (!item) return null;
      const target = (item.querySelector(".pair-badge") as HTMLElement | null) ?? (item as HTMLElement);
      const r = target.getBoundingClientRect();
      return {
        x: (side === "right" ? r.right : r.left) - boardRect.left,
        y: r.top - boardRect.top + r.height / 2,
      };
    };

    const leftItem = (L: number) => board.querySelector(`[data-left="${L}"]`);
    const rightItem = (R: number) => board.querySelector(`[data-right="${R}"]`);

    // user pairings
    Object.entries(pairs).forEach(([left, right]) => {
      const L = Number(left);
      const from = badgeAnchor(leftItem(L), "right");
      const to = badgeAnchor(rightItem(Number(right)), "left");
      if (!from || !to) return;

      let color = "#3f4c52";
      if (checked) color = Number(right) === expected.get(L) ? "#65ae4b" : "#d11111";
      addLine(from.x, from.y, to.x, to.y, color);
    });

    // when checked: reveal the correct pairing for any wrong or unpaired left
    if (checked) {
      expected.forEach((expRight, L) => {
        const userRight = pairs[L];
        if (userRight === expRight) return;
        const from = badgeAnchor(leftItem(L), "right");
        const to = badgeAnchor(rightItem(expRight), "left");
        if (!from || !to) return;
        addLine(from.x, from.y, to.x, to.y, "#65ae4b", true);
      });
    }
  }

  // re-draw lines when the layout changes size
  window.addEventListener("resize", () => {
    const st = getState();
    if (!st) return;
    const area = pairBoardArea();
    if (!area) return;
    const svg = area.querySelector("svg.pair-lines");
    if (!svg) return;
    renderBoard();
  });

  subscribe(renderBoard);
  renderBoard();

  // matched tints are theme-aware (inline vars), so repaint when theme flips
  new MutationObserver(() => renderBoard()).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["data-theme"],
  });
</script>
