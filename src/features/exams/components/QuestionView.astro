---
import { Lock } from "lucide-react";
import { RetryIcon } from "./lucide-icons.tsx";
import { loginUrlFor } from "../../auth/auth-client";

// The button has to carry the `?redirect=` back to this exam, but
// `currentPath()` reads `window`, which does not exist while the page is being
// built — so the markup ships the bare OAuth start and the script at the end of
// this file points it at the real return path in the browser.
const signInHref = loginUrlFor("");
---

<div class="question-view" id="qView">
  <h1 id="qTitle"></h1>
  <pre id="qCode" class="code-block" hidden></pre>
  <div class="question" id="qText"></div>
  <figure class="exhibit" id="qExhibit" hidden></figure>
  <div class="instruction" id="qInstruction"></div>
  <div class="question-body" id="qBody"></div>
  <div class="explanation" id="qExplanation" hidden></div>
  <div class="check-actions" id="checkBar" hidden>
    <button type="button" class="primary check-btn" id="checkAnswerBtn">Check</button>
    <button type="button" class="link-btn retry-btn" id="retryQBtn" hidden>
      <RetryIcon size={15} strokeWidth={2.2} />
      Retry Question
    </button>
  </div>
</div>

{/*
  Sign-in gate, sibling of #qView so it can take over the question body
  wholesale. It is a static placeholder on purpose: a preview attempt holds only
  the free questions, so there is no question text, code, or exhibit to blur.
  The exam page shows it with `qLocked.hidden = false; qView.hidden = true`.

  This is the only sign-in surface in the exam: the Google button starts the
  OAuth flow directly and hands the visitor back to this same question, so the
  questions they already answered in the preview are still there on return.
*/}
<div class="question-locked" id="qLocked" hidden>
  <div class="locked-blur" aria-hidden="true">
    <span class="locked-line"></span>
    <span class="locked-line"></span>
    <span class="locked-line"></span>
    <span class="locked-line"></span>
  </div>
  <div class="locked-veil">
    <Lock size={22} strokeWidth={2} aria-hidden="true" focusable="false" />
    <p class="locked-title">Sign in to unlock the rest of this exam</p>
    <a class="locked-cta" id="qLockedCta" href={signInHref} data-signin>
      <span class="locked-cta-badge" aria-hidden="true">
        <svg viewBox="0 0 18 18" width="16" height="16">
          <path
            fill="#4285F4"
            d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.92c1.7-1.57 2.68-3.88 2.68-6.62Z"
          ></path>
          <path
            fill="#34A853"
            d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.92-2.26c-.8.54-1.84.86-3.04.86-2.34 0-4.32-1.58-5.03-3.7H.96v2.33A9 9 0 0 0 9 18Z"
          ></path>
          <path
            fill="#FBBC05"
            d="M3.97 10.72a5.4 5.4 0 0 1 0-3.44V4.95H.96a9 9 0 0 0 0 8.1l3.01-2.33Z"
          ></path>
          <path
            fill="#EA4335"
            d="M9 3.58c1.32 0 2.5.45 3.44 1.35l2.58-2.58C13.46.9 11.43 0 9 0A9 9 0 0 0 .96 4.95l3.01 2.33C4.68 5.16 6.66 3.58 9 3.58Z"
          ></path>
        </svg>
      </span>
      <span>Sign in with Google</span>
    </a>
    <p class="locked-note">Buksu student accounts only</p>
  </div>
</div>

<script>
  import { currentPath, loginUrlFor } from "../../auth/auth-client";

  const cta = document.getElementById("qLockedCta") as HTMLAnchorElement | null;
  if (cta) cta.href = loginUrlFor(currentPath());
</script>

<style is:global>
  .question-view h1 {
    font-size: 27px;
    margin: 0 0 30px;
    font-weight: 700;
  }

  .question-view .question {
    font-size: 16px;
    line-height: 1.5;
    margin-bottom: 23px;
    max-width: 1000px;
  }

  .question-view .instruction {
    color: #555;
    font-size: 13px;
    margin: -16px 0 16px;
  }

  .question-view .code-block {
    font-family: Consolas, Menlo, Monaco, "DejaVu Sans Mono", monospace;
    font-size: 14px;
    line-height: 1.5;
    background: #f2f2f2;
    color: #000;
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    padding: 14px 16px;
    overflow-x: auto;
    white-space: pre;
    margin: 0 0 20px;
    /* keep horizontal scrolling possible but hide the scrollbar entirely */
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .question-view .code-block::-webkit-scrollbar {
    display: none;
    width: 0;
    height: 0;
  }

  .question-view .exhibit {
    margin: 0 0 20px;
    text-align: center;
  }

  .question-view .exhibit img {
    max-width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: #fff;
  }

  .question-view .exhibit + .exhibit {
    margin-top: 10px;
  }

  .question-view .explanation {
    margin-top: 26px;
    padding: 16px 18px;
    border: 1px solid #bfe0ea;
    border-left: 5px solid var(--cyan);
    background: #eef7fa;
    border-radius: 6px;
    color: #245b6b;
    font-size: 14px;
    line-height: 1.55;
    white-space: pre-line;
  }

  .question-view .check-actions {
    margin-top: 18px;
  }

  .question-view .check-actions:not([hidden]) {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  /* a hidden child must stay hidden even inside the flex row above —
     see the global [hidden] rule in global.css */
  .question-view .check-actions .link-btn {
    color: #245b6b;
  }

  .question-view .check-actions .check-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .question-view .check-actions .check-btn[disabled] {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .question-view .check-actions .retry-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .question-view .check-actions .retry-btn svg {
    display: block;
  }

  .question-view .check-actions .link-btn:hover {
    color: var(--cyan);
  }

  /* --------------------------------------------------------------------------
     Sign-in gate — the preview-mode placeholder the exam page swaps in when a
     signed-out visitor tries to go past the free questions. Only the blurred
     layer is hidden from assistive tech; the veil keeps the padlock, the copy,
     and the sign-in button readable and focusable.
     -------------------------------------------------------------------------- */

  .question-locked {
    position: relative;
    max-width: 1000px;
    min-height: 250px;
    padding: 30px 26px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
    overflow: hidden;
  }

  .question-locked .locked-blur {
    filter: blur(7px);
    pointer-events: none;
    user-select: none;
  }

  .question-locked .locked-line {
    display: block;
    height: 13px;
    margin: 0 0 15px;
    border-radius: 7px;
    background: var(--muted);
  }

  .question-locked .locked-line:nth-child(1) {
    width: 100%;
  }

  .question-locked .locked-line:nth-child(2) {
    width: 88%;
  }

  .question-locked .locked-line:nth-child(3) {
    width: 94%;
  }

  .question-locked .locked-line:last-child {
    width: 62%;
    margin-bottom: 0;
  }

  .question-locked .locked-veil {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 24px;
    text-align: center;
    background: rgba(255, 255, 255, 0.82);
    animation: locked-veil-in 160ms ease-out;
  }

  .question-locked .locked-veil svg {
    display: block;
    color: var(--muted);
  }

  .question-locked .locked-title {
    margin: 0;
    max-width: 34ch;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.4;
    color: var(--text);
  }

  /* Google sign-in button. The badge is the only white surface on it, so the
     four brand colours keep their contrast against the green fill. */
  .question-locked .locked-cta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 4px;
    padding: 10px 20px 10px 11px;
    border-radius: 25px;
    background: var(--green);
    color: #111;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: background 140ms ease-out;
  }

  .question-locked .locked-cta-badge {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    flex: none;
    border-radius: 50%;
    background: #fff;
  }

  .question-locked .locked-cta-badge svg {
    display: block;
  }

  .question-locked .locked-cta:hover {
    background: var(--green-dark);
    color: #fff;
  }

  .question-locked .locked-cta:focus-visible {
    outline: 3px solid rgba(18, 160, 198, 0.45);
    outline-offset: 2px;
  }

  .question-locked .locked-note {
    margin: 2px 0 0;
    font-size: 12.5px;
    color: var(--muted);
  }

  @keyframes locked-veil-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  html[data-theme="dark"] .question-locked .locked-veil {
    background: rgba(15, 18, 21, 0.86);
  }

  html[data-theme="dark"] .question-locked .locked-line {
    background: #434d58;
  }

  @media (prefers-reduced-motion: reduce) {
    .question-locked .locked-veil {
      animation: none;
    }

    .question-locked .locked-cta {
      transition: none;
    }
  }
</style>
