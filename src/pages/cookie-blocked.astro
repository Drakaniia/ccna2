---
import "../styles/global.css";
import { SITE_BASE, loginPageUrl, safeReturnPath } from "../features/auth/auth-client";

// Static page: the query string is not known at build time, so the retry link
// below is only the no-JS fallback. The script at the end of this file points it
// at the path the visitor actually came from.
const redirect = safeReturnPath(Astro.url.searchParams.get("redirect"));
const homeHref = `${SITE_BASE}/`;
const loginHref = loginPageUrl(redirect);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <script is:inline>
      (function () {
        try {
          let t = localStorage.getItem("ccna-theme");
          if (t !== "dark" && t !== "light") t = "light";
          document.documentElement.dataset.theme = t;
        } catch {
          document.documentElement.dataset.theme = "light";
        }
      })();
    </script>
    <title>Sign-in did not finish — CCNA 2 v7 Practice Exams</title>
  </head>
  <body class="cookie-body">
    <main class="cookie-card">
      <span class="cookie-kicker">CCNA 2 v7 Practice Exams</span>
      <h1 id="cookieTitle">Your sign-in did not finish</h1>
      <p class="cookie-lead" id="cookieLead">
        Google signed you in, but the session did not make it back to this page.
        That is usually a sign-in link that was already used or has expired, or
        storage this page needs being blocked.
      </p>
      <ul class="cookie-list" id="cookieTips">
        <li>Press “Try signing in again” and finish the Google prompt in one go.</li>
        <li>Allow cookies and site data for this page — that is where the signed-in session is kept.</li>
        <li>In a private/incognito window nothing survives the hand-over; use a normal window.</li>
      </ul>
      <div class="cookie-actions">
        <a class="cookie-btn primary" id="cookieSignIn" href={loginHref}>Try signing in again</a>
        <a class="cookie-btn ghost" href={homeHref}>Back to home</a>
      </div>
    </main>

    <script>
      import {
        fetchSession,
        loginPageUrl,
        probeAuthService,
        safeReturnPath,
        type AuthServiceState,
      } from "../features/auth/auth-client";

      /**
       * What to say, by whose fault it is. The page is rendered with the
       * "ready" copy and the real cause is filled in below: landing here with a
       * stale auth service is a different problem, with a different owner, than
       * an expired link — and telling a student to change browser settings for
       * a fault on our side is worse than saying nothing.
       */
      const COPY: Record<AuthServiceState, { title: string; lead: string; tips: string[] }> = {
        outdated: {
          title: "Sign-in is broken on our side",
          lead: "The sign-in service is running an older version than this page needs, so it cannot hand your session back. Changing browser or device settings will not help.",
          tips: [
            "Please try again a little later.",
            "If it keeps happening, tell the site owner the auth service needs to be redeployed.",
          ],
        },
        unreachable: {
          title: "The sign-in service is unreachable",
          lead: "This page could not reach the sign-in service at all, so the hand-over never happened. That is a connection problem, not a browser setting.",
          tips: [
            "Check your connection, then press “Try signing in again”.",
            "A VPN, a strict firewall, or offline saving can block it too.",
          ],
        },
        ready: {
          title: "Your sign-in did not finish",
          lead: "Google signed you in, but the session did not make it back to this page. That is usually a sign-in link that was already used or has expired, or storage this page needs being blocked.",
          tips: [
            "Press “Try signing in again” and finish the Google prompt in one go.",
            "Allow cookies and site data for this page — that is where the signed-in session is kept.",
            "In a private/incognito window nothing survives the hand-over; use a normal window.",
          ],
        },
      };

      function applyCopy(state: AuthServiceState): void {
        const copy = COPY[state];
        const title = document.getElementById("cookieTitle");
        const lead = document.getElementById("cookieLead");
        const tips = document.getElementById("cookieTips");
        const retry = document.getElementById("cookieSignIn");

        document.title = `${copy.title} — CCNA 2 v7 Practice Exams`;
        if (title) title.textContent = copy.title;
        if (lead) lead.textContent = copy.lead;
        if (tips) {
          tips.replaceChildren(
            ...copy.tips.map((text) => {
              const li = document.createElement("li");
              li.textContent = text;
              return li;
            }),
          );
        }
        // Retrying cannot work against a service that cannot redeem the link;
        // never offer an action that is guaranteed to fail.
        if (retry) retry.hidden = state === "outdated";
      }

      (async function () {
        const params = new URLSearchParams(window.location.search);
        const dest = safeReturnPath(params.get("redirect"));

        // The retry link was rendered at build time with no query string, so it
        // must be pointed at the path this visitor actually came from.
        const retry = document.getElementById("cookieSignIn") as HTMLAnchorElement | null;
        if (retry) retry.href = loginPageUrl(dest);

        applyCopy(await probeAuthService());

        // If the session is fine after all, get out of the way.
        const session = await fetchSession();
        if (session.authenticated) {
          window.location.replace(dest);
        }
      })();
    </script>
  </body>
</html>

<style>
  .cookie-body {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 32px 18px;
    background: var(--bg);
  }

  .cookie-card {
    width: 100%;
    max-width: 560px;
    background: #fff;
    border: 2px solid var(--border);
    border-radius: 16px;
    padding: 34px 34px 30px;
    box-shadow: 0 10px 30px rgba(40, 70, 40, 0.08);
  }

  .cookie-kicker {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.9px;
    text-transform: uppercase;
    color: var(--cyan);
    margin-bottom: 12px;
  }

  .cookie-card h1 {
    margin: 0 0 14px;
    font-size: 25px;
    line-height: 1.25;
  }

  .cookie-lead {
    margin: 0 0 16px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
  }

  .cookie-list {
    margin: 0 0 8px;
    padding-left: 20px;
  }

  .cookie-list li {
    font-size: 14px;
    line-height: 1.6;
    color: var(--muted);
    margin-bottom: 7px;
  }

  .cookie-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 22px;
  }

  .cookie-btn {
    display: inline-block;
    padding: 11px 22px;
    border-radius: 9px;
    font-size: 14.5px;
    font-weight: 700;
    text-decoration: none;
    border: 2px solid transparent;
  }

  .cookie-btn.primary {
    background: var(--green);
    color: #0f1a0c;
  }

  .cookie-btn.primary:hover {
    background: var(--green-dark);
    color: #fff;
  }

  .cookie-btn.ghost {
    border-color: var(--border);
    color: var(--muted);
  }

  .cookie-btn.ghost:hover {
    background: #f1f5f1;
  }

  html[data-theme="dark"] .cookie-card {
    background: #1d2327;
    border-color: #303a34;
    box-shadow: none;
  }
</style>
