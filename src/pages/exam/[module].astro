---
import "../../styles/global.css";
import ExamHeader from "../../features/exams/components/ExamHeader.astro";
import QuestionTabs from "../../features/exams/components/QuestionTabs.astro";
import QuestionView from "../../features/exams/components/QuestionView.astro";
import ChoiceOptions from "../../features/exams/components/ChoiceOptions.astro";
import PairingBoard from "../../features/exams/components/PairingBoard.astro";
import SubmitOverlay from "../../features/exams/components/SubmitOverlay.astro";
import ResultScreen from "../../features/exams/components/ResultScreen.astro";
import FollowModal from "../../features/exams/components/FollowModal.astro";
import LeaveGuard from "../../features/exams/components/LeaveGuard.astro";
import { availableModules, moduleRegistry } from "../../features/exams/data";
import { PREVIEW_QUESTION_COUNT } from "../../features/auth/auth-client";

export async function getStaticPaths() {
  // Only modules with question data get a route; everything else 404s.
  return moduleRegistry
    .filter((m) => m.available)
    .map((m) => ({ params: { module: m.id } }));
}

const { module: moduleId } = Astro.params;
const mod = availableModules[moduleId] ?? null;
if (!mod) {
  return Astro.redirect(abs(""));
}
const headerTitle = `${mod.title}: ${mod.subtitle}`;

// Absolute-path helper that stays correct under a repo-name `base` (GitHub Pages).
const abs = (p: string) => `${import.meta.env.BASE_URL.replace(/\/?$/, "/")}${p}`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        try {
          let t = localStorage.getItem("ccna-theme");
          if (t !== "dark" && t !== "light") t = "light";
          document.documentElement.dataset.theme = t;
        } catch {
          document.documentElement.dataset.theme = "light";
        }
      })();
      // Keep the exam hidden until the access mode resolves, so no question is
      // ever painted before we know whether this visitor is on a preview or the
      // full bank. Released in both modes — nothing stays invisible.
      document.documentElement.dataset.auth = "pending";
    </script>
    <link rel="icon" type="image/svg+xml" href={abs("favicon.svg")} />
    <link rel="icon" href={abs("favicon.ico")} />
    <title>{headerTitle} — CCNA 2 v7 Practice Exam</title>
  </head>
  <body data-module={mod.id} data-phase="intro">
    <div class="app" id="quizApp">
      <ExamHeader title={headerTitle} currentId={mod.id} />

      <!-- Intro — minimal centered, no box background -->
      <section id="introScreen" class="intro-screen" aria-label="Exam instructions">
        <div class="intro-center">
          <span class="intro-label">{mod.groupLabel}</span>
          <h1>{mod.title}: {mod.subtitle}</h1>
          <p class="intro-qcount" id="introQCount">{mod.questions.length} Questions</p>
          <p class="intro-warn">Your progress is saved automatically as you go — if you refresh or close the page, you can pick up right where you left off. You can retake this exam as many times as you like.</p>
          <p class="intro-warn" id="introPreviewNote" hidden>Answer the first {PREVIEW_QUESTION_COUNT} questions free — sign in to take the full exam.</p>
          <p class="intro-shortcut desktop-only">Desktop: use <kbd>←</kbd> <kbd>→</kbd> to go back / next · press <kbd>R</kbd> to shuffle the choices (or retry the question once it is checked).</p>
          <button type="button" class="primary intro-start" id="startExamBtn">Start Exam</button>
          <div class="intro-resume" id="introResume" hidden>
            <p class="intro-resume-info" id="introResumeInfo"></p>
            <button type="button" class="primary intro-start" id="resumeExamBtn">Resume Session</button>
            <button type="button" class="intro-restart" id="restartExamBtn">Start New Exam</button>
          </div>
        </div>
      </section>

      <QuestionTabs />
      <main>
        <QuestionView />
      </main>

      <div class="progress" id="progress"></div>

      <footer class="quiz-footer">
        <button type="button" class="link-btn" id="skipAllBtn">Skip All</button>
        <button type="button" class="link-btn" id="reviewQBtn" aria-pressed="false">Review Question</button>
        <button type="button" class="primary" id="footerNextBtn">Submit</button>
      </footer>
    </div>

    <SubmitOverlay />
    <ResultScreen />

    {/** question-type renderers mount into #qBody (inside QuestionView) */}
    <ChoiceOptions />
    <PairingBoard />

    <div class="site-credit site-credit-exam">
      <button type="button" class="site-credit-btn" data-follow-open>
        Made with 🧡 by Alistair Ybanez
      </button>
    </div>

    <FollowModal />
    <LeaveGuard />

    <style is:global>
      /* Intro screen — minimal centered, no box background */
      .intro-screen {
        display: none;
        min-height: 56vh;
        padding: 48px 24px 60px;
        justify-content: center;
        align-items: center;
        text-align: center;
      }

      body[data-phase="intro"] .intro-screen {
        display: flex;
      }

      body[data-phase="intro"] .quiz-nav,
      body[data-phase="intro"] main,
      body[data-phase="intro"] .progress,
      body[data-phase="intro"] footer.quiz-footer {
        display: none !important;
      }

      .intro-center {
        max-width: 540px;
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0;
      }

      .intro-label {
        display: inline-block;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.8px;
        text-transform: uppercase;
        color: var(--cyan);
        margin-bottom: 10px;
      }

      .intro-center h1 {
        margin: 0;
        font-size: 26px;
        line-height: 1.25;
        font-weight: 800;
        color: var(--text);
      }

      .intro-qcount {
        margin: 10px 0 0;
        font-size: 14px;
        font-weight: 600;
        color: var(--muted);
      }

      .intro-warn {
        margin: 20px 0 0;
        font-size: 14.5px;
        line-height: 1.6;
        color: var(--muted);
        max-width: 460px;
      }

      .intro-shortcut {
        margin: 12px 0 0;
        font-size: 12.5px;
        color: #8a9ba3;
      }

      .intro-shortcut kbd {
        display: inline-block;
        min-width: 22px;
        text-align: center;
        padding: 1px 5px;
        font-family: inherit;
        font-size: 11px;
        font-weight: 700;
        background: #fff;
        border: 1px solid #d0d7db;
        border-bottom-width: 2px;
        border-radius: 4px;
        line-height: 1.2;
        vertical-align: middle;
      }

      .intro-start {
        margin-top: 28px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 16px !important;
        font-weight: 700 !important;
        padding: 12px 42px !important;
        min-width: 160px;
        background: var(--green) !important;
        color: #111 !important;
        box-shadow: 0 4px 14px rgba(77, 152, 56, 0.28);
        transition: background 0.15s ease, transform 0.12s ease, box-shadow 0.15s ease;
      }

      .intro-start:hover {
        background: var(--green-dark) !important;
        color: #fff !important;
        transform: translateY(-1px);
        box-shadow: 0 6px 18px rgba(77, 152, 56, 0.32);
      }

      .intro-start:active {
        transform: translateY(0);
        box-shadow: 0 2px 8px rgba(77, 152, 56, 0.2);
      }

      .intro-start:focus-visible {
        outline: 3px solid rgba(18, 160, 198, 0.35);
        outline-offset: 2px;
      }

      /* Resume row — shown instead of Start Exam when a save exists. */
      .intro-resume {
        margin-top: 28px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 14px;
      }

      .intro-resume .intro-start {
        margin-top: 0;
      }

      .intro-resume-info {
        margin: 0;
        font-size: 13.5px;
        font-weight: 600;
        color: var(--muted);
        max-width: 440px;
        line-height: 1.5;
      }

      .intro-restart {
        background: none;
        border: 0;
        padding: 0;
        font-family: inherit;
        font-size: 14px;
        color: var(--muted);
        text-decoration: underline;
        cursor: pointer;
        transition: color 0.15s ease;
      }

      .intro-restart:hover {
        color: var(--text);
      }

      .intro-restart:focus-visible {
        outline: 2px solid var(--cyan);
        outline-offset: 3px;
        border-radius: 4px;
      }

      html[data-theme="dark"] .intro-shortcut kbd {
        background: #2a3038;
        border-color: #434d58;
        color: #e3e6ea;
      }

      @media (max-width: 800px) {
        .intro-shortcut.desktop-only {
          display: none;
        }
      }

      /* Preview mode — the tab strip runs the real module length, so the
         positions past the free questions are dimmed rather than missing. They
         stay focusable on purpose: a `disabled` tab is skipped by screen readers
         and the keyboard, which would hide the only sign-in path. */
      .qtab.locked {
        opacity: 0.42;
        border-style: dashed;
        border-color: #b9c1c6;
        color: var(--muted);
        cursor: pointer;
      }

      .qtab.locked:hover {
        opacity: 0.72;
      }

      .qtab.locked:focus-visible {
        outline: 2px solid var(--cyan);
        outline-offset: 2px;
      }

      /* The gate's own tab: the current position, but a locked one. The dark
         green `current` fill is the "answered" signal everywhere else, so the
         locked surface is kept and the position is marked with a solid border
         and full opacity instead. */
      .qtab.locked.current {
        opacity: 1;
        background: #fff;
        border-style: solid;
        border-width: 2px;
        border-color: var(--green-dark);
        color: var(--green-dark);
        font-weight: 600;
      }

      html[data-theme="dark"] .qtab.locked.current {
        background: #23272d;
        border-color: var(--green);
        color: #a9d18f;
      }

      @media (max-width: 600px) {
        .intro-screen {
          min-height: 50vh;
          padding: 32px 18px 40px;
        }
        .intro-center h1 {
          font-size: 22px;
        }
      }
    </style>

    <script>
      import { availableModules } from "../../features/exams/data";
      import { exhibitList } from "../../features/exams/lib/types";
      import { isQuestionCorrect } from "../../features/exams/lib/scoring";
      import { getEffectiveCount, LIMIT_EVENT } from "../../features/exams/lib/exam-limits";
      import { getCheckMode, MODE_EVENT } from "../../features/exams/lib/exam-mode";
      import {
        cookieBlockedUrl,
        currentPath,
        fetchSession,
        publishAccessMode,
        type AccessMode,
      } from "../../features/auth/auth-client";
      import {
        attemptHasProgress,
        atGate,
        backToQuiz,
        bootQuiz,
        checkCurrent,
        clearCurrentAnswer,
        currentQuestion,
        getModule,
        getState,
        goNext,
        goPrev,
        goTo,
        goToGate,
        hasAnswerFor,
        loadSaved,
        openSubmit,
        promotePreviewAttempt,
        questionCount,
        rebootWithLimit,
        resetQuiz,
        reshuffleCurrent,
        resumeQuiz,
        reviewAssessment,
        skipAll,
        submitQuiz,
        subscribe,
        toggleReview,
        unansweredPositions,
        type AttemptState,
      } from "../../features/exams/lib/quiz-state";

      function main(access: AccessMode): void {
        const moduleId = document.body.dataset.module ?? "";
        const mod = availableModules[moduleId];
        if (!mod) return;

        /*
         * Signing in part-way through the public preview used to throw those
         * answers away: attempts are namespaced per access mode, so full mode
         * looked for a key the preview never wrote. The preview is promoted into
         * a full attempt first, and a promotion is resumed straight away — the
         * visitor came back mid-exam and should land on the question they left,
         * not on the intro screen.
         */
        const promoted = access === "full" && promotePreviewAttempt(moduleId, mod);

        // Site root when deployed under a repo-name base path (GitHub Pages).
        const siteRoot = import.meta.env.BASE_URL.replace(/\/$/, "");

        const $ = (id: string): HTMLElement | null => document.getElementById(id);

        /* ---------------- static chrome that needs re-rendering ---------------- */

        let lastShellPos = -1;
        let lastPhase = "";
        let followTimer = 0;

        subscribe(chrome);

        // Intro question count reflects per-exam limit (random subset). A preview
        // keeps the real module count (D3) — the cap is stated once, on the
        // preview note below, instead of by quietly shrinking this number.
        function renderIntroCount(): void {
          const el = $("introQCount");
          if (!el) return;
          const real = mod.questions.length;
          const effective = access === "preview" ? real : getEffectiveCount(moduleId, real);
          el.textContent = `${effective} Question${effective !== 1 ? "s" : ""}`;
        }
        renderIntroCount();
        const previewNote = $("introPreviewNote");
        if (access === "preview" && previewNote) previewNote.hidden = false;
        document.addEventListener(LIMIT_EVENT, (e) => {
          const detail = (e as CustomEvent).detail as { moduleId?: string } | undefined;
          if (!detail || detail.moduleId === moduleId) renderIntroCount();
        });
        // Settings modal may request an immediate reboot with new random subset.
        document.addEventListener("exam:limit-apply-restart", () => {
          if (!started) {
            renderIntroCount();
            return;
          }
          try {
            rebootWithLimit(mod);
            started = true;
            lastShellPos = -1;
          } catch {
            /* not booted yet */
          }
        });

        // The solution-feedback mode is a global preference and can be switched
        // mid-exam, so re-sync the check bar whenever it changes.
        document.addEventListener(MODE_EVENT, () => {
          syncCheckBar();
        });

        // Intro flow: quiz does not start until the user presses Start Exam
        // (or Resume Session when a saved attempt exists).
        const startBtn = $("startExamBtn") as HTMLButtonElement | null;
        const resumeBtn = $("resumeExamBtn") as HTMLButtonElement | null;
        const restartBtn = $("restartExamBtn") as HTMLButtonElement | null;
        const resumeBox = $("introResume");
        const resumeInfo = $("introResumeInfo");
        let started = false;

        function focusFirstTab(): void {
          // Move focus into the quiz for immediate keyboard navigation.
          window.requestAnimationFrame(() => {
            const firstTab = document.querySelector(".qtab.current") as HTMLElement | null;
            firstTab?.focus?.();
          });
        }

        function startExam(): void {
          if (started) return;
          started = true;
          bootQuiz(moduleId, mod, access); // fresh shuffle — discards any saved attempt
          lastShellPos = -1;
          focusFirstTab();
        }

        /** One-line summary of the saved attempt for the intro screen. */
        function describeSaved(s: AttemptState): string {
          const total = s.order.length;
          let answered = 0;
          s.order.forEach((sourceIndex, p) => {
            const q = mod.questions[sourceIndex];
            const has =
              q.type === "pair"
                ? !!s.pairs[p] && Object.keys(s.pairs[p] ?? {}).length > 0
                : (s.answers[p]?.length ?? 0) > 0;
            if (has) answered += 1;
          });
          const flagged = s.reviewed.filter(Boolean).length;
          const flagText = flagged > 0 ? ` · ${flagged} flagged for review` : "";
          if (s.phase === "result" && s.result) {
            return `Completed — scored ${s.result.score}% · ${answered} of ${total} answered${flagText}`;
          }
          // The position clause shows the real module total so a preview never
          // reads as if the module were only five questions long (D3); the
          // answered count stays scoped to the attempt.
          const shownTotal = s.access === "preview" ? s.total : total;
          return `In progress — ${answered} of ${total} answered · Question ${
            s.current + 1
          } of ${shownTotal}${flagText}`;
        }

        function resumeSession(): void {
          if (started) return;
          const restored = resumeQuiz(moduleId, mod, access);
          if (!restored) {
            // Save went bad between load and click — fall back to a fresh attempt.
            startExam();
            return;
          }
          started = true;
          lastShellPos = -1;
          focusFirstTab();
        }

        /**
         * A saved attempt only counts as a session once there is something to
         * come back to — see `attemptHasProgress`, which is also what decides
         * whether a preview is worth promoting after sign-in.
         */

        // Saved session with progress? Swap Start Exam for Resume / Start New Exam + a summary.
        // A promotion already decided what this visit resumes, so the intro is
        // not consulted at all.
        const saved = promoted ? null : loadSaved(moduleId, mod, access);
        const hasSession = !!saved && attemptHasProgress(saved, mod);
        if (saved && hasSession && resumeBox) {
          if (startBtn) startBtn.hidden = true;
          resumeBox.hidden = false;
          if (resumeInfo) resumeInfo.textContent = describeSaved(saved);
        }

        startBtn?.addEventListener("click", startExam);
        resumeBtn?.addEventListener("click", resumeSession);
        restartBtn?.addEventListener("click", startExam);

        // Allow Enter/Space on the intro card to begin as well (accessibility).
        // Default action follows what the screen offers: resume when there is a
        // saved attempt, fresh start otherwise.
        document.getElementById("introScreen")?.addEventListener("keydown", (e) => {
          if (!started && (e.key === "Enter" || e.key === " ")) {
            const target = e.target as HTMLElement;
            if (target.tagName === "BUTTON") return;
            e.preventDefault();
            if (hasSession) resumeSession();
            else startExam();
          }
        });

        // A visitor who came back from signing in mid-preview lands straight in
        // the exam they left, with their answered questions intact.
        if (promoted) resumeSession();

        /**
         * The footer is inert on the gate: there is no question to move on from
         * and nothing to submit, so the buttons read as unavailable rather than
         * quietly doing nothing when pressed.
         */
        function syncFooter(): void {
          const gate = atGate(getState());
          for (const id of ["footerNextBtn", "skipAllBtn", "reviewQBtn"]) {
            const btn = $(id) as HTMLButtonElement | null;
            if (btn) btn.disabled = gate;
          }
        }

        function chrome(): void {
          const st = getState();
          const m = getModule();
          if (!st || !m) return;

          document.body.dataset.phase = st.phase;

          renderTabs();
          renderProgress();

          if (st.current !== lastShellPos) {
            lastShellPos = st.current;
            renderQuestionShell();
          }
          syncExplanation();
          syncExhibitVisibility();
          syncCheckBar();
          syncReviewBtn();
          syncFooter();

          if (st.phase === "submit") renderSubmitView();
          if (st.phase === "result") renderResultView();

          // Edge-triggered, so the prompt asks once when the score lands and not
          // again on every later quiz:change while the result screen is still up.
          // Delayed so the gauge and score read first — the follow ask comes
          // after the result lands, never on top of it. The prompt ignores the
          // request once GitHub has been followed.
          if (st.phase !== lastPhase) {
            lastPhase = st.phase;
            window.clearTimeout(followTimer);
            if (st.phase === "result") {
              followTimer = window.setTimeout(() => {
                document.dispatchEvent(new CustomEvent("follow:open"));
              }, 2200);
            }
          }
        }

        /** Reveal-only exhibit images are shown once the question is checked. */
        function syncExhibitVisibility(): void {
          const st = getState();
          const exhibit = $("qExhibit");
          if (!st || !exhibit) return;
          const reveal = !!st.checked[st.current];
          let anyVisible = false;
          exhibit.querySelectorAll("img").forEach((im) => {
            const el = im as HTMLImageElement;
            if (el.dataset.reveal === "1") {
              el.hidden = !reveal;
              anyVisible = anyVisible || reveal;
            } else {
              anyVisible = true;
            }
          });
          exhibit.hidden = !anyVisible;
        }

        /**
         * Drives the row under the question: Check (manual mode, until the
         * solution is revealed), plus Retry once it is revealed. Re-runs on
         * every state change and whenever the mode is switched in the settings
         * modal, so no stale visibility survives a mode change.
         */
        function syncCheckBar(): void {
          const st = getState();
          const bar = $("checkBar");
          if (!st || !bar) return;

          // The gate has no question under it, so there is nothing to check —
          // and `hasAnswerFor` must not be asked about a locked position.
          if (atGate(st)) {
            bar.hidden = true;
            return;
          }

          const p = st.current;
          const isChecked = !!st.checked[p];
          const manual = getCheckMode() === "manual";

          const checkBtn = $("checkAnswerBtn") as HTMLButtonElement | null;
          const showCheck = manual && !isChecked;

          if (checkBtn) {
            checkBtn.hidden = !showCheck;
            checkBtn.disabled = !hasAnswerFor(p);
            checkBtn.title = checkBtn.disabled ? "Select an answer first" : "Reveal the solution";
          }
          const retryBtn = $("retryQBtn");
          if (retryBtn) retryBtn.hidden = !isChecked;

          bar.hidden = !showCheck && !isChecked;
        }

        /**
         * The footer "Review Question" button reports the current question's
         * flag: pressed while it is flagged, so the state is readable without
         * going back to the tab strip. Pressing it again only moves on, so the
         * flag is deliberately not a toggle and the tooltip does not offer to
         * clear it.
         */
        function syncReviewBtn(): void {
          const st = getState();
          const btn = $("reviewQBtn");
          if (!st || !btn) return;
          const isReviewed = !!st.reviewed[st.current];
          btn.setAttribute("aria-pressed", isReviewed ? "true" : "false");
          btn.title = isReviewed
            ? "Flagged for review — its tab is orange. Press to move to the next question."
            : "Flag this question for review — its tab turns orange, then moves on.";
        }

        function renderProgress(): void {
          const st = getState();
          const el = $("progress");
          if (!st || !el) return;
          // A preview attempt is shorter than the module, so it reports the real
          // total; full mode keeps the limit-aware count it has always shown.
          const total = st.access === "preview" ? st.total : questionCount();
          el.textContent = `${st.current + 1} of ${total} Questions`;
        }

        function renderTabs(): void {
          const st = getState();
          const m = getModule();
          const tabs = $("tabs");
          if (!st || !m || !tabs) return;

          const p = st.current;
          tabs.replaceChildren();

          // One tab per *attempt position*, not per module question: a question
          // limit makes st.order shorter than m.questions, and every lookup
          // below (answers, skipped, goTo) is keyed by attempt position. A
          // preview is the exception: the strip runs the full module length
          // (D3) and the positions past the attempt become locked sign-in
          // affordances, so the exam does not look five questions long.
          const tabCount = access === "preview" ? m.questions.length : st.order.length;
          for (let idx = 0; idx < tabCount; idx += 1) {
            const btn = document.createElement("button");
            btn.type = "button";
            btn.textContent = `Q${idx + 1}`;

            if (idx >= st.order.length) {
              // No answered / wrong / reviewed state: there is no attempt here
              // to have state. `aria-disabled` rather than `disabled` so the tab
              // stays reachable and announces why it does nothing.
              btn.className = "qtab locked";
              btn.setAttribute("aria-disabled", "true");
              btn.title = "Sign in to unlock";
              // The gate sits on the first locked tab, so that one is the
              // current position — the cursor really is one past the attempt.
              if (idx === p) btn.classList.add("current");
              btn.addEventListener("click", openGate);
              tabs.appendChild(btn);
              continue;
            }

            btn.className = "qtab";
            const q = m.questions[st.order[idx]];
            const answered =
              q.type === "pair"
                ? !!st.pairs[idx] && Object.keys(st.pairs[idx] ?? {}).length > 0
                : (st.answers[idx]?.length ?? 0) > 0;

            if (idx === p) {
              btn.classList.add("current");
            } else if (st.reviewed[idx]) {
              // Flagged to revisit — orange wins over every other state. It has
              // to be tested above `unanswered`, because "Review Question"
              // flags and moves on without answering, so a flagged question is
              // usually unanswered and would otherwise never turn orange.
              btn.classList.add("reviewed");
            } else if (st.skipped[idx] || !answered) {
              btn.classList.add("unanswered");
            } else if (st.checked[idx] && !isQuestionCorrect(q, st, idx)) {
              btn.classList.add("wrong");
            } else {
              // answered (and not wrong) — filled green
              btn.classList.add("answered");
            }

            btn.addEventListener("click", () => goTo(idx));
            tabs.appendChild(btn);
          }

          // keep the current tab visible in the scroll strip
          const cur = tabs.querySelector(".qtab.current");
          if (cur) {
            const el = cur as HTMLElement;
            const target = el.offsetLeft - (tabs.clientWidth - el.clientWidth) / 2;
            tabs.scrollLeft = Math.max(0, target);
          }
        }

        /**
         * Take the question body over with the sign-in gate. Transient: a
         * preview attempt only ever holds the free questions, so the real
         * question 6 text is never in the DOM to show. The gate carries the
         * Google sign-in button, so asking to go further and signing in are one
         * click apart and no page sits in between.
         */
        function showLockPanel(): void {
          const view = $("qView");
          const panel = $("qLocked");
          if (!view || !panel) return;
          panel.hidden = false;
          view.hidden = true;
        }

        /**
         * Sitting on the last free question, where going further costs a sign-in.
         * A module small enough to fit inside the preview has nothing to unlock,
         * so it never opens the gate (spec §7).
         */
        function atPreviewEnd(): boolean {
          if (access !== "preview") return false;
          const st = getState();
          if (!st || st.order.length >= st.total) return false;
          return st.current >= st.order.length - 1;
        }

        /** Put the cursor on the first locked question, where the gate lives. */
        function openGate(): void {
          goToGate();
        }

        /** Open the gate, but only when going further is actually gated. */
        function goToLogin(): void {
          if (!atPreviewEnd()) return; // nothing is locked yet — let the click through
          openGate();
        }

        function renderQuestionShell(): void {
          const st = getState();
          const view = $("qView");
          const panel = $("qLocked");
          if (!st || !view || !panel) return;

          if (st.access === "preview" && atGate(st)) {
            showLockPanel();
            return;
          }
          panel.hidden = true;
          view.hidden = false;

          const q = currentQuestion();
          if (!q) return;

          const title = $("qTitle");
          const code = $("qCode");
          const text = $("qText");
          const exhibit = $("qExhibit");
          const instruction = $("qInstruction");

          if (title) title.textContent = `Question ${st.current + 1}`;

          const hasCode = "code" in q && !!q.code;
          if (code) {
            if (hasCode) {
              code.textContent = q.code ?? "";
              code.hidden = false;
            } else {
              code.hidden = true;
            }
          }

          if (text) text.textContent = q.text;

          if (exhibit) {
            const images = exhibitList("exhibit" in q ? q.exhibit : undefined);
            exhibit.replaceChildren();
            if (images.length > 0) {
              images.forEach((img, i) => {
                const el = document.createElement("img");
                el.src = siteRoot + img.src;
                el.alt = img.alt;
                if (i > 0) el.loading = "lazy";
                if (img.width) el.width = img.width;
                if (img.height) el.height = img.height;
                // answer-revealing screenshots stay hidden until the user presses Check
                if (img.revealOnly) el.dataset.reveal = "1";
                exhibit.appendChild(el);
              });
              exhibit.hidden = false;
            } else {
              exhibit.hidden = true;
            }
          }

          if (instruction) {
            if (q.type === "multi") {
              instruction.textContent = `(Choose ${q.choose ?? 2}.)`;
            } else {
              instruction.textContent = "";
            }
          }
        }

        function syncExplanation(): void {
          const st = getState();
          const el = $("qExplanation");
          if (!st || !el) return;
          const q = currentQuestion();
          if (st.checked[st.current] && q?.explanation) {
            el.textContent = q.explanation;
            el.hidden = false;
          } else {
            el.hidden = true;
          }
        }

        /* ------------------------------ submit screen ----------------------------- */

        function renderSubmitView(): void {
          const host = $("submitUnanswered");
          const tabs = $("submitReviewTabs");
          const confirm = $("confirmSubmit") as HTMLInputElement | null;
          if (confirm) confirm.checked = false;

          const unanswered = unansweredPositions();
          if (host) {
            if (unanswered.length > 0) {
              host.textContent = `You have ${unanswered.length} unanswered question${
                unanswered.length !== 1 ? "s" : ""
              }.`;
              host.style.display = "";
            } else {
              host.textContent = "";
              host.style.display = "none";
            }
          }

          if (tabs) {
            tabs.replaceChildren();
            unanswered.forEach((pos) => {
              const btn = document.createElement("button");
              btn.type = "button";
              btn.textContent = `Q${pos + 1}`;
              btn.addEventListener("click", () => backToQuiz(pos));
              tabs.appendChild(btn);
            });
          }
        }

        /* ------------------------------- result screen ----------------------------- */

        function renderResultView(): void {
          const st = getState();
          if (!st?.result) return;

          const score = st.result.score;
          const passed = st.result.passed;

          // sweeping semicircle arc: dash length = score% of the arc length (π × radius)
          const svg = document.querySelector(".gauge-svg");
          if (svg) {
            svg.setAttribute("aria-valuenow", String(score));
          }
          const arc = $("gaugeArc") as SVGPathElement | null;
          if (arc) {
            const length = Math.PI * 86; // arc radius from the viewBox path
            arc.style.strokeDasharray = `0 ${length}`;
            arc.style.stroke = passed ? "#65ae4b" : "#d11111";
            requestAnimationFrame(() => {
              arc.style.strokeDasharray = `${(length * score) / 100} ${length}`;
            });
          }
          const scoreText = $("scoreText");
          if (scoreText) scoreText.textContent = `${score}%`;
          const scoreMsg = $("scoreMessage");
          if (scoreMsg) scoreMsg.textContent = `You have scored ${score}%.`;
          const passMsg = $("passMessage");
          if (passMsg) {
            passMsg.textContent = passed
              ? "You have passed the exam."
              : "You have not passed the exam.";
          }
        }

        /* ------------------------------ event wiring ------------------------------ */

        const el = (id: string): HTMLElement | null => document.getElementById(id);

        el("retryQBtn")?.addEventListener("click", () => {
          clearCurrentAnswer();
        });
        el("checkAnswerBtn")?.addEventListener("click", () => {
          checkCurrent();
        });
        el("footerNextBtn")?.addEventListener("click", () => {
          const st = getState();
          if (!st) return;
          // The gate is not a question: there is nothing to advance to and
          // nothing to submit, so the button does nothing until they sign in.
          if (atGate(st)) return;
          if (st.current < st.order.length - 1) {
            // Advancing out of a preview attempt is a sign-in prompt. The
            // button reads Submit on the last free question, so that path is
            // left alone below (D6) — the prompt comes from `→`, Review
            // Question, and the locked tabs.
            if (atPreviewEnd()) {
              goToLogin();
              return;
            }
            goNext();
          } else {
            openSubmit();
          }
        });
        el("skipAllBtn")?.addEventListener("click", () => {
          // Skipping everything from the gate would submit an attempt that was
          // never really taken; the sign-in is the only way forward here.
          if (atGate(getState())) return;
          skipAll();
        });
        el("reviewQBtn")?.addEventListener("click", () => {
          if (atGate(getState())) return;
          if (atPreviewEnd()) {
            goToLogin();
            return;
          }
          const st = getState();
          if (!st) return;
          // Flags the current question (its tab turns orange) and moves on.
          // An already-flagged question is left flagged — pressing again is a
          // plain "next", not an unflag, so the tab never silently goes grey.
          if (!st.reviewed[st.current]) toggleReview();
          if (st.current < st.order.length - 1) goNext();
          else openSubmit();
        });

        el("doSubmitBtn")?.addEventListener("click", () => {
          const confirm = document.getElementById("confirmSubmit") as HTMLInputElement | null;
          if (!confirm?.checked) {
            alert("Please confirm your submission.");
            return;
          }
          submitQuiz();
        });

        const tabsEl = document.getElementById("tabs");
        el("navLeft")?.addEventListener("click", () => {
          if (tabsEl) tabsEl.scrollBy({ left: -360, behavior: "smooth" });
        });
        el("navRight")?.addEventListener("click", () => {
          if (tabsEl) tabsEl.scrollBy({ left: 360, behavior: "smooth" });
        });

        el("resetBtn")?.addEventListener("click", () => {
          // Reset brings a fresh shuffle and returns to quiz phase directly
          resetQuiz();
          started = true;
          lastShellPos = -1;
        });
        el("reviewBtn")?.addEventListener("click", () => {
          reviewAssessment();
        });

        /* -------------------- keyboard shortcuts (desktop only) ------------------- */
        // Left / Right arrows to move between questions. Disabled on mobile/tablet
        // where swipe/scroll is the primary interaction.

        function isDesktop(): boolean {
          return window.matchMedia("(min-width: 801px)").matches;
        }

        // Input types that actually take typed text. Everything else (the
        // answer radios/checkboxes) is part of the quiz UI, so a shortcut must
        // still fire while one of them holds focus.
        const TEXT_INPUT_TYPES = new Set([
          "text",
          "search",
          "url",
          "tel",
          "email",
          "password",
          "number",
          "date",
          "datetime-local",
          "month",
          "time",
          "week",
        ]);

        function isTypingTarget(target: EventTarget | null): boolean {
          if (!(target instanceof HTMLElement)) return false;
          const tag = target.tagName;
          if (tag === "TEXTAREA" || tag === "SELECT") return true;
          if (tag === "INPUT") {
            const type = (target as HTMLInputElement).type;
            // Unknown/empty type defaults to "text" per the HTML spec.
            return type === "" || TEXT_INPUT_TYPES.has(type);
          }
          if (target.isContentEditable) return true;
          return false;
        }

        document.addEventListener("keydown", (e) => {
          // Ignore when drawer is open, or when user is typing
          if (isTypingTarget(e.target)) return;
          // Ignore combos with modifiers (allow browser shortcuts)
          if (e.ctrlKey || e.metaKey || e.altKey) return;
          // Intro phase: Enter already handled; arrows do nothing until quiz starts
          const st = getState();
          if (!st) return;
          if (st.phase !== "quiz") return;
          // On the gate there is no question under the cursor, so only the two
          // arrows mean anything — the rest would read past the attempt.
          if (atGate(st) && e.key !== "ArrowLeft" && e.key !== "ArrowRight") return;
          // Desktop only
          if (!isDesktop()) return;
          if (e.key === "ArrowRight") {
            e.preventDefault();
            if (atPreviewEnd()) {
              goToLogin();
              return;
            }
            if (st.current < st.order.length - 1) goNext();
            else openSubmit();
          } else if (e.key === "ArrowLeft") {
            e.preventDefault();
            goPrev();
          } else if (e.key === "r" || e.key === "R") {
            if (st.checked[st.current]) {
              e.preventDefault();
              clearCurrentAnswer();
            } else if (!hasAnswerFor(st.current)) {
              // Nothing selected yet — just re-randomize the choices / board.
              e.preventDefault();
              reshuffleCurrent();
            }
          }
        });
      }

      async function init(): Promise<void> {
        const session = await fetchSession();
        // A `?auth=ok` return that still looks signed out means the browser
        // dropped the cross-site cookie — the same bounce as before. It only
        // happens after a real sign-in attempt, never on a plain preview visit.
        if (!session.authenticated && new URLSearchParams(location.search).get("auth") === "ok") {
          // Carry this exam's path along, so the recovery page's retry link can
          // bring the student straight back here once cookies are allowed.
          location.replace(cookieBlockedUrl(currentPath()));
          return;
        }
        const access: AccessMode = session.authenticated ? "full" : "preview";
        document.documentElement.dataset.auth = "ok";
        publishAccessMode(access);
        main(access);
      }

      init();
    </script>
  </body>
</html>
