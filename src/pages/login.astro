---
import "../styles/global.css";
import { ArrowLeft, ArrowRight, CircleHelp, GraduationCap, Lock } from "lucide-react";
import { AUTH_BASE_URL, SITE_BASE } from "../features/auth/auth-client";

// Only same-site paths under the repo base are accepted as a return target, so
// the login page can never become an open redirect.
function safeRedirect(raw: string): string {
  const base = SITE_BASE ?? "";
  const fallback = `${base}/`;
  if (!raw) return fallback;
  const value = raw.trim();
  if (!value.startsWith("/") || value.startsWith("//") || value.includes("\\")) return fallback;
  const pathOnly = value.split(/[?#]/)[0];
  if (base === "") return value;
  if (pathOnly === base || pathOnly === `${base}/`) return value;
  if (!pathOnly.startsWith(`${base}/`)) return fallback;
  return value;
}

const redirect = safeRedirect(Astro.url.searchParams.get("redirect") ?? "");
const loginHref = `${AUTH_BASE_URL}/auth/login?redirect=${encodeURIComponent(redirect)}`;
const homeHref = `${SITE_BASE}/`;
const privacyHref = `${SITE_BASE}/privacy/`;

// Left-hand hero photo. Built from SITE_BASE so it stays correct under the
// `/ccna2` GitHub Pages base path. Width/height are the real pixel dimensions of
// the committed file — keep them in sync so the img reserves its space (no CLS).
const heroSrc = `${SITE_BASE}/images/login_picture.png`;
const heroWidth = 1000;
const heroHeight = 600;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <script is:inline>
      (function () {
        try {
          let t = localStorage.getItem("ccna-theme");
          if (t !== "dark" && t !== "light") t = "light";
          document.documentElement.dataset.theme = t;
        } catch {
          document.documentElement.dataset.theme = "light";
        }
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href={`${SITE_BASE}/favicon.svg`} />
    <title>Sign in — CCNA 2 v7 Practice Exams</title>
  </head>
  <body class="auth-body">
    <main class="auth-split">
      <!-- Decorative: alt="" keeps it out of the accessibility tree. -->
      <div class="auth-visual">
        <img
          class="auth-visual-img"
          src={heroSrc}
          alt=""
          width={heroWidth}
          height={heroHeight}
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </div>

      <section class="auth-card">
        <span class="auth-kicker">
          <!-- React components need `className`, not `class`. -->
          <GraduationCap className="auth-kicker-icon" size={18} aria-hidden="true" />
          CCNA 2 v7 — SRWE Practice Exams
        </span>
        <h1>Sign in to take the exams</h1>
        <p class="auth-subtitle">
          For security, access is protected by a sign-in layer limited to verified
          Buksu student accounts.
        </p>

        {/*
          Eligibility help. The account rules live only in this popover, so the card
          face stays a short sign-in prompt. The trigger is a real button so keyboard
          and screen-reader users get it for free.
        */}
        <div class="auth-help">
          <button
            type="button"
            class="auth-help-btn"
            id="authHelpBtn"
            aria-haspopup="dialog"
            aria-controls="authEligibility"
            aria-expanded="false"
            aria-label="Who can sign in?"
          >
            <CircleHelp className="auth-help-icon" size={18} aria-hidden="true" />
          </button>

          <div
            class="auth-popover"
            id="authEligibility"
            role="dialog"
            aria-label="Who can sign in?"
            hidden
          >
            <p class="auth-popover-text">
              Practice exams are limited to <strong>Buksu student accounts</strong> — a
              numeric student ID on the <code>student.buksu.edu.ph</code> domain
              (for example <code>2401117078@student.buksu.edu.ph</code>).
            </p>
          </div>
        </div>

        <a class="auth-google" id="googleSignIn" href={loginHref}>
          <span class="auth-google-badge" aria-hidden="true">
            <svg viewBox="0 0 18 18" width="16" height="16">
              <path
                fill="#4285F4"
                d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.92c1.7-1.57 2.68-3.88 2.68-6.62Z"
              ></path>
              <path
                fill="#34A853"
                d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.92-2.26c-.8.54-1.84.86-3.04.86-2.34 0-4.32-1.58-5.03-3.7H.96v2.33A9 9 0 0 0 9 18Z"
              ></path>
              <path
                fill="#FBBC05"
                d="M3.97 10.72a5.4 5.4 0 0 1 0-3.44V4.95H.96a9 9 0 0 0 0 8.1l3.01-2.33Z"
              ></path>
              <path
                fill="#EA4335"
                d="M9 3.58c1.32 0 2.5.45 3.44 1.35l2.58-2.58C13.46.9 11.43 0 9 0A9 9 0 0 0 .96 4.95l3.01 2.33C4.68 5.16 6.66 3.58 9 3.58Z"
              ></path>
            </svg>
          </span>
          <span class="auth-google-label">Sign in with Google</span>
          <span class="auth-google-arrow" aria-hidden="true">
            <ArrowRight size={14} />
          </span>
        </a>

        <section class="auth-privacy">
          <span class="auth-privacy-icon" aria-hidden="true">
            <Lock size={16} />
          </span>
          <h2 class="auth-privacy-title">Privacy</h2>
          <p class="auth-privacy-body">
            (Data Privacy Act, RA 10173): when you sign in we store your student ID,
            name, email, profile picture, and sign-in times in our own database to keep
            track of who uses the exams. We do not store your password and we do not
            share this data. Ask 
            <a
              class="auth-policy-link"
              href="https://github.com/Drakaniia"
              target="_blank"
              rel="noreferrer noopener"
            >
              <span>creator</span>
            </a>
             to have your record removed.
            <a class="auth-policy-link" href={privacyHref}>Read the full privacy policy →</a>
          </p>
        </section>

        <a class="auth-home" href={homeHref}>
          <ArrowLeft size={16} aria-hidden="true" />
          Back to exam selection
        </a>
      </section>
    </main>

    <script>
      import { fetchSession, sitePath } from "../features/auth/auth-client";

      (async function () {
        const params = new URLSearchParams(window.location.search);
        const target = params.get("redirect") ?? "";
        const dest = target.startsWith("/") ? target : sitePath("");

        const session = await fetchSession();
        if (session.authenticated) {
          // Already signed in — skip the login page.
          window.location.replace(dest);
          return;
        }

        // Returned from a "successful" callback yet still signed out: the
        // browser is blocking the cross-site cookie.
        if (params.get("auth") === "ok") {
          window.location.replace(sitePath("cookie-blocked"));
        }
      })();
    </script>

    <script>
      /**
       * Eligibility popover.
       *
       * Non-modal: focus deliberately stays on the trigger, so there is no focus
       * trap and no scroll lock. Keyed off the `hidden` attribute plus an
       * `is-open` class, mirroring the drawer in ExamHeader.astro so the fade has
       * something to transition between.
       */
      const helpBtnEl = document.getElementById("authHelpBtn");
      const helpPanelEl = document.getElementById("authEligibility");
      if (!helpBtnEl || !helpPanelEl) throw new Error("eligibility popover markup missing");

      // Aliased so the nested handlers keep their non-null narrowing.
      const helpBtn = helpBtnEl;
      const helpPanel = helpPanelEl;
      const helpCard = document.querySelector<HTMLElement>(".auth-card");

      /** Must match the transition duration in the stylesheet. */
      const CLOSE_MS = 150;
      let open = false;
      let closeTimer: number | undefined;

      function onDocClick(e: MouseEvent): void {
        if (!open) return;
        const target = e.target as Node | null;
        if (!target) return;
        if (helpBtn.contains(target) || helpPanel.contains(target)) return;
        closeHelp();
      }

      function onKey(e: KeyboardEvent): void {
        if (e.key === "Escape") closeHelp();
      }

      function closeHelp(): void {
        if (!open) return;
        open = false;
        helpBtn.setAttribute("aria-expanded", "false");
        helpPanel.classList.remove("is-open");
        document.removeEventListener("click", onDocClick);
        window.removeEventListener("keydown", onKey);
        helpCard?.removeEventListener("scroll", closeHelp);
        closeTimer = window.setTimeout(() => {
          helpPanel.hidden = true;
          closeTimer = undefined;
        }, CLOSE_MS);
      }

      function openHelp(): void {
        if (open) return;
        open = true;
        if (closeTimer !== undefined) {
          window.clearTimeout(closeTimer);
          closeTimer = undefined;
        }
        helpPanel.hidden = false;
        helpBtn.setAttribute("aria-expanded", "true");
        // Force a synchronous style flush so the panel's "hidden at opacity 0"
        // state is committed before `is-open` changes it — otherwise the
        // transition has no starting value to animate from. Deliberately not
        // requestAnimationFrame: if the next frame is delayed, the panel would
        // sit at opacity 0 with outside-clicks inert until it arrived.
        void helpPanel.offsetWidth;
        helpPanel.classList.add("is-open");
        // Safe to register immediately: the containment check in onDocClick
        // ignores the very click that opened the panel.
        document.addEventListener("click", onDocClick);
        window.addEventListener("keydown", onKey);
        helpCard?.addEventListener("scroll", closeHelp, { passive: true });
      }

      helpBtn.addEventListener("click", () => (open ? closeHelp() : openHelp()));
    </script>
  </body>
</html>

<style>
  /* ---------- page shell: full-viewport 60/40 split on desktop ---------- */

  /* Login-local palette (soft lavender / blue). Deliberately literal and scoped
     to this page — the site's global --cyan / --green-dark tokens are untouched. */
  .auth-body {
    --auth-blue: #2f56f5;
    /* Button fill is tracked separately from the text/link blue so dark mode can
       keep white label text above the 4.5:1 AA threshold — a lightened blue fill
       would only reach ~3.3:1. */
    --auth-blue-fill: #2f56f5;
    --auth-blue-fill-hover: #1f42d6;
    --auth-ink: #1c2143;
    --auth-slate: #5a6079;
    --auth-line: #e9e7fb;
    --auth-panel: #f4f6fd;
    --auth-chip: #eef2fb;
    --auth-chip-ink: #3b4265;
    --auth-chip-on-blue: rgba(255, 255, 255, 0.16);
    --auth-shadow: 0 24px 60px rgba(76, 63, 190, 0.12);

    min-height: 100vh;
    min-height: 100dvh;
    overflow: hidden;
    /* Soft glow over the card column; the photo covers the other half. */
    background: radial-gradient(
      120% 110% at 66% 0%,
      #ece9ff 0%,
      #f5f4ff 38%,
      #fdfdfe 68%,
      #ffffff 100%
    );
  }

  /* The global `main` rule in global.css caps width at 1030px and adds page
     margins; both have to go for the split to reach the viewport edges. */
  main.auth-split {
    max-width: none;
    margin: 0;
    padding: 0;
    height: 100vh;
    height: 100dvh;
    display: grid;
    grid-template-columns: 60% 40%;
  }

  /* ---------- left: full-bleed photo column ---------- */

  .auth-visual {
    position: relative; /* anchors the dark-theme scrim */
    overflow: hidden;
    background: var(--bg);
  }

  .auth-visual-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* ---------- right: card column ---------- */

  .auth-card {
    /* Positioning context for the help icon pinned in the top-right corner. */
    position: relative;
    /* Stretches across its grid track, inset by the gutter margins. */
    max-width: none;
    margin: 0 40px;
    align-self: center;
    /* Leave room above and below so the card never touches the viewport edge
       and its shadow is never clipped. */
    max-height: calc(100dvh - 64px);
    overflow-y: auto;
    background: #fff;
    border: 1px solid var(--auth-line);
    border-radius: 24px;
    padding: 36px 36px 30px;
    box-shadow: var(--auth-shadow);
  }

  .auth-kicker {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    /* Reserves the pinned help icon's footprint so a long kicker can never run
       underneath it. */
    padding-right: 36px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--auth-slate);
    margin-bottom: 14px;
  }

  .auth-kicker-icon {
    display: block;
    flex: none;
    color: var(--auth-blue);
  }

  .auth-card h1 {
    margin: 0 0 8px;
    font-size: 33px;
    line-height: 1.16;
    font-weight: 800;
    color: var(--auth-ink);
  }

  .auth-subtitle {
    margin: 0 0 18px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--auth-slate);
  }

  /* ---------- eligibility help ---------- */

  /* Pinned to the card's top-right corner. It spans the card's content box so the
     popover inside can be sized against it — that is what keeps the panel inside
     the card at every width. */
  .auth-help {
    position: absolute;
    top: 36px;
    left: 36px;
    right: 36px;
    display: flex;
    justify-content: flex-end;
    z-index: 6;
  }

  .auth-help-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--auth-slate); /* quiet until hovered */
    cursor: pointer;
    transition:
      color 0.15s ease,
      background 0.15s ease;
  }

  .auth-help-btn:hover,
  .auth-help-btn:focus-visible,
  .auth-help-btn[aria-expanded="true"] {
    color: var(--auth-blue);
  }

  .auth-help-icon {
    display: block;
  }

  /* Sized to the card's content box, so the panel can never be clipped by the
     card's own scroll container. */
  .auth-popover {
    position: absolute;
    top: calc(100% + 10px);
    right: 0; /* the icon's right edge */
    z-index: 5;
    width: 100%;
    padding: 18px 20px;
    background: var(--auth-panel);
    border: 1px solid var(--auth-line);
    border-radius: 14px;
    box-shadow: 0 16px 40px rgba(76, 63, 190, 0.16);
    opacity: 0;
    transform: scale(0.97) translateY(-4px);
    transform-origin: top right; /* grows out of the icon/caret corner */
    transition:
      opacity 0.15s ease,
      transform 0.15s ease;
  }

  .auth-popover.is-open {
    opacity: 1;
    transform: none;
  }

  /* Caret aimed back up at the icon. */
  .auth-popover::before {
    content: "";
    position: absolute;
    top: -6px;
    right: 10px;
    width: 10px;
    height: 10px;
    background: var(--auth-panel);
    border-left: 1px solid var(--auth-line);
    border-top: 1px solid var(--auth-line);
    transform: rotate(45deg);
  }

  .auth-popover-text {
    margin: 0 0 12px;
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--auth-slate);
  }

  .auth-popover-text:last-child {
    margin-bottom: 0;
  }

  .auth-popover-text strong {
    color: var(--auth-ink);
  }

  .auth-popover-text code {
    font-size: 12.5px;
    background: var(--auth-chip);
    color: var(--auth-chip-ink);
    border-radius: 6px;
    padding: 1px 6px;
    /* The example student address is one long unbreakable token; let it wrap
       rather than spill out of the panel. */
    overflow-wrap: anywhere;
  }

  /* ---------- Google sign-in button ---------- */

  .auth-google {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin: 10px 0 4px;
    padding: 8px 10px 8px 8px;
    border: 0;
    border-radius: 14px;
    background: var(--auth-blue-fill);
    color: #fff;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    transition:
      background 0.15s ease,
      box-shadow 0.15s ease,
      transform 0.15s ease;
  }

  .auth-google:hover {
    background: var(--auth-blue-fill-hover);
    box-shadow: 0 12px 26px rgba(47, 86, 245, 0.32);
    transform: translateY(-1px);
  }

  .auth-google:active {
    transform: none;
    box-shadow: none;
  }

  .auth-google:focus-visible,
  .auth-home:focus-visible,
  .auth-help-btn:focus-visible {
    outline: 2px solid var(--auth-blue);
    outline-offset: 3px;
  }

  .auth-google-badge {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    flex: none;
    border-radius: 50%;
    background: #fff;
  }

  .auth-google-badge svg {
    display: block;
  }

  .auth-google-arrow {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    flex: none;
    border-radius: 50%;
    background: var(--auth-chip-on-blue);
  }

  .auth-google-arrow svg {
    display: block;
  }

  /* ---------- privacy panel ---------- */

  .auth-privacy {
    margin: 22px 0 0;
    padding: 20px 22px;
    background: var(--auth-panel);
    border-radius: 16px;
  }

  .auth-policy-link {
    color: var(--cyan);
    white-space: nowrap;
  }

  .auth-privacy-icon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    margin-bottom: 12px;
    border-radius: 10px;
    background: #fff;
    color: var(--auth-blue);
  }

  .auth-privacy-title {
    margin: 0 0 6px;
    font-size: 15px;
    font-weight: 700;
    color: var(--auth-ink);
  }

  .auth-privacy-body {
    margin: 0;
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--auth-slate);
    /* Even left and right edges; the final line stays ragged, as justified
       text should. */
    text-align: justify;
  }

  /* ---------- back link ---------- */

  .auth-home {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: 20px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--auth-blue);
    text-decoration: none;
  }

  .auth-home:hover {
    color: var(--auth-blue-hover);
  }

  .auth-home svg {
    display: block;
    flex: none;
  }

  /* Between the collapse point and ~1100px the 40% column gets too narrow for
     the card's padding and the Google button starts wrapping, so tighten both.
     The 60/40 ratio itself is unchanged. */
  @media (max-width: 1100px) {
    .auth-card {
      margin: 0 24px;
      padding: 28px 26px 24px;
    }

    /* Keep the pinned icon in step with the tightened card padding. */
    .auth-help {
      top: 28px;
      left: 26px;
      right: 26px;
    }
  }

  /* ---------- dark theme: navy / indigo translation ---------- */

  html[data-theme="dark"] .auth-body {
    --auth-blue: #6b83ff;
    --auth-blue-hover: #7f93ff;
    --auth-blue-fill: #4a63e8;
    --auth-blue-fill-hover: #3f55d4;
    --auth-ink: #eef0ff;
    --auth-slate: #a3a9c4;
    --auth-line: #2a2f4d;
    --auth-panel: #20253f;
    --auth-chip: #232a4d;
    --auth-chip-ink: #cdd3f0;
    --auth-chip-on-blue: rgba(255, 255, 255, 0.18);
    --auth-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);

    background: radial-gradient(
      120% 110% at 66% 0%,
      #232748 0%,
      #1a1d33 42%,
      #12141f 100%
    );
  }

  html[data-theme="dark"] .auth-card {
    background: #1b1f36;
    border-color: #2a2f4d;
    box-shadow: var(--auth-shadow);
  }

  html[data-theme="dark"] .auth-privacy-icon {
    background: #2a3050;
  }

  /* Flat scrim so the photo doesn't glare against the dark UI (dark theme only). */
  html[data-theme="dark"] .auth-visual::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.35);
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .auth-popover {
      transition: none;
      transform: none;
    }
  }

  /* ---------- narrow screens: drop the photo, center the card ---------- */

  @media (max-width: 900px) {
    .auth-body {
      display: grid;
      place-items: center;
      padding: 32px 18px;
      overflow: visible;
    }

    main.auth-split {
      display: block;
      width: 100%;
      max-width: 560px;
      height: auto;
    }

    .auth-visual {
      display: none;
    }

    .auth-card {
      margin: 0;
      max-height: none;
      overflow: visible;
    }
  }
</style>
